# Gmail OAuth (client-side). Keep the OAuth consent screen in "Testing"
# status while developing — publishing/verification is a real hassle on a
# course timeline. See PROJECT_STATUS.md.
VITE_GOOGLE_CLIENT_ID=

# Only used if the frontend is deployed somewhere other than same-origin
# as the backend (vite.config.ts proxies /api -> localhost:8000 in dev).
VITE_API_BASE_URL=http://localhost:8000
