POSTGRES_USER=dmp_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dmp

# Different from tap-fe/tab-be's 5432/8080 so both stacks can run at once
DATABASE_PORT=5433
ADMINER_PORT=8081

# Same OAuth client as app/frontend/.env.local's NEXT_PUBLIC_GOOGLE_CLIENT_ID —
# generate the secret via Cloud Console > Credentials > that client > Reset secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3011/auth/gmail/callback
FRONTEND_URL=http://localhost:3010
